{
  "name": "midterm-crud-api",
  "version": "1.0.0",
  "description": "1. What was the most challenging part of building this API?\r The most challenging part was configuring TypeScript decorator metadata options (experimentalDecorators and emitDecoratorMetadata) so that TypeORM could properly interpret the entity classes, along with managing clean asynchronous error handling across all CRUD endpoints.",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/config/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/data-source.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuraido77/midterm-crud-api.git"
  },
  "bugs": {
    "url": "https://github.com/Kuraido77/midterm-crud-api/issues"
  },
  "homepage": "https://github.com/Kuraido77/midterm-crud-api#readme"
}
